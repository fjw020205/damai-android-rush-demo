{
  // 一台手机保持 null；多台手机才填写 check-device.bat 显示的序列号。
  "serial": null,
  // App 已预选观演人时保持空数组；否则改为 false 并填写姓名。
  "users": [],
  // 场次按页面横向从左到右数，第一项是 1；没有场次页填 null。
  "session_index": 1,
  // 票档按页面横向从左到右数，第一项是 1。
  "price_index": 1,
  "preselected_sku": false,
  "probe_only": false,
  "if_commit_order": false,
  "skip_attendee_selection": true,
  "skip_quantity_adjustment": true,
  "auto_navigate": false,
  // 只改这一项：例如 2026-08-16T10:18:00+08:00。
  "sell_start_time": null,
  "cta_first_tap_delay_ms": 0,
  "rush_mode": true,
  "rush_skip_price_dump": true,
  "fast_retry_count": 1,
  "fast_retry_interval_ms": 80
}

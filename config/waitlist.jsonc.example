{
  // 轮询间隔（毫秒），建议 3000–5000
  "poll_interval_ms": 3000,
  // 每轮都刷新（页面不支持下拉刷新，只能返回重进）
  "refresh_each_poll": true,
  // reenter = 返回详情页再点立即预订；swipe = 下拉（该页面无效果）
  "refresh_mode": "reenter",
  // 连续多少次刷新页面完全没变化后，做一次强力刷新
  "stale_limit": 3,
  // 强力刷新也无效时是否重启大麦 App（会回到首页，慎用）
  "restart_when_stale": false,
  // 关闭每轮刷新后，改用定时刷新（秒），0 表示不刷新
  "refresh_every_s": 0,
  // 同一状态重复通知冷却（秒）
  "cooldown_s": 30,
  // 目标日期，页面文本需包含；留空表示不校验
  "target_date": "2026-11-21",
  // 目标价（整数），只接受 <= 目标价的票档
  "target_price": 688,
  "allow_lower_price": true,
  // 命中后自动进入确认页（不会提交订单）
  "auto_navigate": true,
  "session_index": 2,
  "price_index": 6
}
